{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block banner %}
    <div class="jumbotron">
        <div class="snow foreground"></div>
        <div class="snow foreground layered"></div>
        <div class="snow middleground"></div>
        <div class="snow middleground layered"></div>

        <div class="jumbotron-inner hero">
            <div class="hero-text">
                <p class="hero-kicker">
                    <span>Free</span>
                    <span>Open-source</span>
                    <span>No registration</span>
                </p>

                <h1>Throw a Secret Santa with <mark>your team</mark></h1>

                <p>
                    <strong>Randomly</strong> assign to each member of your <strong>team</strong> (colleagues, friends or family)
                    a person to whom they anonymously <strong>give a gift</strong>.
                </p>

                <div class="actions">
                    <a class="action hvr-buzz action-slack" href="{{ path('run', { application: 'slack' }) }}">
                        <i class="custom-fa-slack"></i> Run on Slack
                    </a>
                    <a class="action hvr-buzz action-discord" href="{{ path('run', { application: 'discord' }) }}">
                        <i class="custom-fa-discord"></i> Run on Discord
                    </a>
                    <a class="action hvr-buzz action-webex" href="{{ path('run', { application: 'webex' }) }}">
                        <i class="custom-fa-webex"></i> Run on Webex <sup>new!</sup>
                    </a>
                </div>

                {% if totalCount > 0 %}
                    <p class="hero-counter">
                        <i class="fas fa-gift" aria-hidden="true"></i>
                        Already <strong>{{ totalCount|number_format(0, '.', ' ') }}</strong> Secret Santas organized with us.
                    </p>
                {% endif %}
            </div>

            {# The private message each participant receives, as it shows in Slack #}
            <figure class="hero-message" aria-label="Sample private message received by a participant">
                <div class="chat-header">
                    <img src="{{ asset('images/logo.png') }}" alt="" class="chat-avatar">
                    <strong>Secret Santa Bot</strong> <span class="chat-badge">APP</span> <span class="chat-time">14:31</span>
                </div>
                <div class="chat-body">
                    <p>Hi!<br>You have been selected to be part of a Secret Santa 🎅!</p>
                    <p>Someone will get you a gift and <strong>you have been chosen to gift:</strong><br>🎁 <span class="chat-mention">@dwarfgrumpy</span> 🎁</p>
                    <p><strong>Here is a message from the Secret Santa admin:</strong></p>
                    <p>Oh oh oh 🎅!<br>Our Christmas party will take place on December 14th. We suggest a budget of 20€ and wish you good luck in your gift hunting!</p>
                    <p class="chat-footer">Organized with <a href="{{ path('homepage') }}">Secret-Santa.team</a> by admin <span class="chat-mention">@Loïck</span>.</p>
                </div>
            </figure>
        </div>
    </div>
{% endblock banner %}

{% block content %}
    <div class="home">
        {# A few names from the hall of fame, as social proof right under the hero #}
        <div class="content logo-strip">
            <p>They organized their Secret Santa with us</p>
            <ul>
                {% for company in [
                    {label: '20 Minutes', image: '20minutes.png', stacked: true},
                    {label: 'BlaBlaCar', image: 'blablacar.png', stacked: true},
                    {label: 'SensioLabs', image: 'sensiolabs.png'},
                    {label: 'Perkbox', image: 'perkbox-logo.png'},
                    {label: 'Buy Me a Coffee', image: 'buymeacoffee.png'},
                    {label: 'JoliCode', image: 'jolicode.svg'},
                ] %}
                    <li><img src="{{ asset('images/hall-of-fame/' ~ company.image) }}" alt="{{ company.label }}" loading="lazy"{% if company.stacked|default(false) %} class="is-stacked"{% endif %}></li>
                {% endfor %}
            </ul>
            <a href="{{ path('hall_of_fame') }}">See the hall of fame <i class="fas fa-angle-right" aria-hidden="true"></i></a>
        </div>

        <div class="content what-block">
            <h2 class="content-head is-center">What is a Secret Santa?</h2>

            <blockquote>
                <strong>Secret Santa</strong> is a Western Christmas tradition in which members of a group or
                community are <strong>randomly</strong> assigned a person to whom they anonymously <strong>give a gift</strong>.
                The identity of the gift giver is a <strong>secret</strong> not to be revealed.
            </blockquote>

            <p class="aliases">
                Also known as
                <span>🇮🇪 Kris Kringle</span>
                <span>🇩🇪 Wichteln</span>
                <span>🇦🇹 Engerl und Bengerl</span>
                <span>🇪🇸 Amigo invisible</span>
                <span>🇧🇪 Cacahuète</span>
            </p>
        </div>

        {{ include('content/_steps.html.twig') }}

        <div class="content trust-block">
            <h2 class="content-head is-center">Enjoy gifts, love and privacy</h2>

            <ul class="trust">
                <li class="trust-card">
                    <i class="fas fa-gift" aria-hidden="true"></i>
                    <h3>Free, forever</h3>
                    <p>No registration, no paid plan, no ads, no spam. Built by <a href="https://jolicode.com/">JoliCode</a> for its own Secret Santa, and shared with everyone since 2015.</p>
                </li>
                <li class="trust-card">
                    <i class="fab fa-github" aria-hidden="true"></i>
                    <h3>Open-source</h3>
                    <p>The whole application is <a href="https://github.com/jolicode/secret-santa/">on GitHub</a>. Read it, fork it, or help us support <a href="https://github.com/jolicode/secret-santa/issues/140">Google Chat</a>, <a href="https://github.com/jolicode/secret-santa/issues/142">Zoom</a> or <a href="https://github.com/jolicode/secret-santa/issues/151">Matrix</a>.</p>
                </li>
                <li class="trust-card">
                    <i class="fas fa-user-shield" aria-hidden="true"></i>
                    <h3>Private by design</h3>
                    <p>No personal information collected, no web analytics, no newsletter.</p>
                </li>
            </ul>
        </div>
    </div>
{% endblock content %}
