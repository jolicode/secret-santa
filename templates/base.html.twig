<!DOCTYPE html>
<html lang="en" xmlns:og="http://ogp.me/ns#">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3">
        <link rel="manifest" href="/site.webmanifest?v=3">
        <link rel="mask-icon" href="/safari-pinned-tab.svg?v=3" color="#d32b33">
        <link rel="shortcut icon" href="/favicon.ico?v=3">
        <meta name="apple-mobile-web-app-title" content="Secret Santa">
        <meta name="application-name" content="Secret Santa">
        <meta name="msapplication-TileColor" content="#aa1017">
        <meta name="theme-color" content="#aa1017">

        <meta name="slack-app-id" content="AP0Q2FLEB">

        {% block seo %}
            {{ include('_seo.html.twig') }}
        {% endblock %}

        <link rel="stylesheet" href="{{ asset('fontawesome/css/all.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block stylesheets %}{% endblock %}

        {% if 'production' == bugsnag_release_stage and bugsnag_api_key is not empty %}
            <meta name="bugsnag-api-key" content="{{ bugsnag_api_key }}">
            {% if bugsnag_app_version %}
                <meta name="bugsnag-app-version" content="{{ bugsnag_app_version }}">
            {% endif %}
        {% endif %}

        {% block javascripts %}
            {{ importmap('app', {nonce: csp_nonce('script')}) }}
        {% endblock %}
    </head>
    <body>

        <header class="header">
            <nav class="home-menu">
                <a class="site-brand" href="{{ path('homepage') }}">
                    <span class="logo-wrapper">
                        <img src="{{ asset('images/logo' ~ (spoilInProgress is defined ? '-spoiler' : '') ~ '.png') }}" alt="" />
                    </span>
                    Secret Santa
                </a>

                {% set route = app.request.attributes.get('_route') %}
                <ul class="menu-list">
                    <li>
                        <a class="menu-link" href="{{ path('hall_of_fame') }}"{% if route == 'hall_of_fame' %} aria-current="page"{% endif %}><i class="fas fa-star" aria-hidden="true"></i> Hall of Fame</a>
                    </li>
                    <li>
                        <a class="menu-link" href="{{ path('faq') }}"{% if route == 'faq' %} aria-current="page"{% endif %}><i class="fas fa-question-circle" aria-hidden="true"></i> Help</a>
                    </li>
                    <li>
                        <a target="_blank" rel="noreferrer" class="menu-link" href="https://github.com/jolicode/secret-santa/"><i class="fab fa-github" aria-hidden="true"></i> GitHub</a>
                    </li>
                </ul>
            </nav>
        </header>

        {% block banner %}{% endblock banner %}

        <div class="content-wrapper">
            {% block content %}
            {% endblock content %}

            <div class="support is-center">
                {% block contact %}
                    <p>Need help? <a href="{{ path('faq') }}">Read the FAQ</a> or <a href="mailto:hello@secret-santa.team">write to us</a>.</p>
                {% endblock contact %}
            </div>
        </div>

        {{ include('_joli_footer.html.twig') }}
    </body>
</html>
