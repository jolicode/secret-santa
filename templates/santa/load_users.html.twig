{% extends 'santa/base.html.twig' %}

{% set currentStep = 1 %}

{% block santa_content %}
    <div class="content progress-page is-center">
        {% if app.request.query.get('error') %}
            <h2 class="content-head is-center">An unexpected error happened!</h2>

            <p class="error">
                <span class="fas fa-exclamation-triangle"></span>
                &nbsp;
                An error occurred while loading users. Please try again later.
            </p>

            <div class="is-center">
                <a href="{{ path('load_users', {application: application}) }}" class="big-button">
                    <span class="fas fa-redo" aria-hidden="true"></span>
                    Try again
                </a>
            </div>
        {% else %}
            <span class="step-icon" aria-hidden="true"><i class="fas fa-spinner spin"></i></span>
            <h2 class="content-head is-center">Loading the members of your team</h2>

            <div class="progress-box">
                <p>
                    <strong>Keep this window open.</strong><br />
                    Large teams take a moment, you will be redirected automatically once everyone is loaded.
                </p>

                <p class="progress-count"
                   data-load-users-url="{{ url('load_users', {application: application}) }}"
                   data-load-users-error-url="{{ url('load_users', {application: application, error: true}) }}"
                   data-load-users-next-url="{{ url('participants', {application: application}) }}">
                    <strong class="js-count-value">{{ count }}</strong> members loaded
                </p>
            </div>
        {% endif %}
    </div>
{% endblock santa_content %}
{% block javascripts %}
    {{ importmap(['app', 'santa/load_users'], {nonce: csp_nonce('script')}) }}
{% endblock %}
