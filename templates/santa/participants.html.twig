{% extends 'santa/base.html.twig' %}

{% set currentStep = 1 %}
{% set hasRestrictedUser = hasRestrictedUser|default(false) %}

{% block santa_content %}
    <div class="run-block">
        <h2>Select the participants of your Secret Santa</h2>

        {% if errors is not empty %}
            <span class="error">
                <i class="fas fa-exclamation-triangle"></i>
                {% for error in errors %}<br>{{ error }}{% endfor %}
            </span>
        {% endif %}

        {% if users|length >= 2 %}
            <form action="" id="run_form" method="POST">
            <div class="pure-g">
                    <div class="pure-u-1 pure-u-lg-1-2">
                        <div class="run-column run-column-left">
                            <div class="sticky-container">
                                <div class="sticky">
                                    <h3 class="is-center">Available users ({{ users | length }})</h3>
                                    {% if groups %}
                                        <div class="group-selection">
                                            <label>Select all people in a group with one click:</label>
                                            <div class="group-list" id="group-list">
                                                {% for group in groups %}
                                                    <span class="group-button" data-user-ids="{{ group.userIds|join('|') }}" title="Select {{ group.userIds|length }} people in this group">{{ group.name }}</span>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}

                                    <p class="is-center">
                                        Below is the list of all the users in your team. Select the ones that will
                                        participate to your Secret Santa.
                                    </p>

                                    <div class="user-helper is-center">
                                        {% if hasRestrictedUser %}
                                            <label>
                                                <input type="checkbox" checked="checked" id="restrict-user-checkbox" value="" />
                                                <span>Show restricted user</span>
                                            </label>
                                        {% endif %}
                                        <span class="check-all" id="all-checker" title="Check all the visible users in the list below">Check all</span>
                                        <span class="uncheck-all" id="all-unchecker" title="Uncheck all the visible users in the list below">Uncheck all</span>
                                    </div>

                                    <div class="user-search">
                                        <input autofocus placeholder="🔎    Search user by real name or username" type="text" id="user-search-input" autocomplete="off" />
                                        <span class="search-cleaner fas fa-times is-hidden" id="search-cleaner" title="Empty the query"></span>
                                    </div>
                                    {% apply spaceless %}
                                        <div class="user-container">
                                            <div class="user-list user-list-simple-rows" id="user-list">
                                                <div class="no-result is-hidden" id="no-user-matching">
                                                    No user matching.
                                                </div>
                                                {% for user in users %}
                                                    {% block user_item %}{% endblock %}
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endapply %}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="pure-u-1 pure-u-lg-1-2">
                        <div class="run-column run-column-right">
                            <div class="sticky-container">
                                <div class="sticky">
                                    <div class="is-center">
                                        <h3 class="is-center">Ready for next step?</h3>

                                        <p>
                                            You selected <strong id="summary-count"></strong>.
                                            If you are ready, let's validate the current selection and move to next step, a.k.a "message customization".
                                        </p>

                                        {% block disclaimer %}{% endblock %}

                                        <button type="submit" class="big-button" id="submit-button">
                                            <span class="fas fa-users" aria-hidden="true"></span>
                                            Validate selection
                                        </button>
                                    </div>

                                    <p class="is-center">
                                        <small>
                                            or <a href="{{ path('cancel', {application: application}) }}">cancel everything</a>
                                        </small>
                                    </p>

                                    <div class="checked-users-summary">
                                        <h3 class="is-center">Summary of your selection</h3>
                                        <div id="checked-users-summary" class="is-center"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

        {% else %}
            <div class="error" role="alert">
                Ooops, we didn't find enough users in your team. You need at least 2 users to start a Secret Santa.
            </div>

            {% if application == 'webex' %}
                <div class="error" role="alert">
                    <i class="custom-fa-webex" style="vertical-align: text-bottom;"></i> You need to be in a messaging Space with the people you want to participate with. <a href="{{ path('cancel', { application: 'webex' }) }}">Retry</a>.
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endblock santa_content %}
{% block javascripts %}
    {{ importmap(['app', 'santa/participants'], {nonce: csp_nonce('script')}) }}
{% endblock %}
