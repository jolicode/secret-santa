{% extends 'santa/message.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('vendor/flatpickr/dist/flatpickr.min.css') }}">
{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'santa/message', 'santa/message_slack'], {nonce: csp_nonce('script')}) }}
{% endblock %}

{% block user_item %}
    <img src="{{ user.extra.image }}" alt="{{ user.name }}" width="32" height="32" loading="lazy" />
    <span title="{{ user.name }} ({{ user.extra.nickname }})">{{ user.name }}</span>
{% endblock %}

{% block options %}
    <div class="user-field message-step">
        <h3><label for="{{ form.options.scheduled_at_tz.vars.id }}">Want to schedule the message to a later date?</label></h3>

        <p>If not, you can just leave this field <strong>empty</strong>.</p>

        <div class="scheduling">
            {{ form_widget(form.options.scheduled_at_tz, {attr: {readonly: 'readonly', 'data-scheduling-display': ''}}) }}
            <span id="scheduling-clear" class="scheduling-clear fas fa-times" title="Remove the scheduling date"></span>
        </div>

        {{ form_widget(form.options.scheduled_at, {attr: {style: 'display: none;', 'data-scheduling-timestamp': ''}}) }}

    </div>
{% endblock %}
