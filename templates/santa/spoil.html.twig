{% set spoilInProgress = true %}

{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/santa.css') }}">
{% endblock %}

{% block content %}
    <div class="content spoil-block">
        <h2 class="content-head is-center">Spoiling Santa</h2>

        {% if associations %}
            <p class="spoil-intro">
                Here is the secret repartition. Keep it to yourself!
            </p>

            <ul class="spoil-list">
                {% for giver,receiver in associations %}
                    <li><strong>{{ giver }}</strong> <span>must offer a gift to</span> <strong>{{ receiver }}</strong></li>
                {% endfor %}
            </ul>

            <div class="is-center">
                <a href="{{ path('homepage') }}" class="big-button">
                    <span class="fas fa-redo" aria-hidden="true"></span>
                    Start another Secret Santa
                </a>
            </div>
        {% else %}
            <p class="spoil-intro">
                As the organizer, you received a private message with a <strong>spoil code</strong> right after the draw.
                Paste it below to reveal who gifts whom.
            </p>

            {% if invalidCode %}
                <p class="error">
                    This code could not be decoded. Make sure you copied it entirely and try again.
                </p>
            {% endif %}

            <form method="post" id="run_form" class="spoil-form">
                <div class="code-field">
                    <textarea name="code" id="code" rows="6" placeholder="Paste your spoil code here">{{ code }}</textarea>
                </div>

                <div class="is-center">
                    <button type="submit" class="big-button">
                        <span class="fas fa-user-secret" aria-hidden="true"></span>
                        Reveal the repartition
                    </button>
                </div>
            </form>
        {% endif %}
    </div>
{% endblock content %}
