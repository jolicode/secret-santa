{% extends 'santa/base.html.twig' %}

{% set currentStep = 5 %}

{% block santa_content %}
    <div class="content send-messages is-center">
        <h2>
            <span class="fas fa-spinner spin"></span>
            &nbsp;
            We are sending private messages!
        </h2>

        <p>
            <strong>Do not close the window!</strong><br />
            You will be redirected to the finish page automatically once all the messages were sent.
        </p>

        {% set sentCount = secretSanta.associations|length - secretSanta.remainingAssociations|length %}
        <progress id="count-progress" value="{{ sentCount }}" max="{{ secretSanta.associations|length }}"
                  data-url="{{ url('send_messages', {hash: secretSanta.hash}) }}"
                  data-finish-url="{{ url('finish', {hash: secretSanta.hash}) }}">
            <span class="js-count-value">{{ sentCount }}</span> / {{ secretSanta.associations|length }} messages sent.
        </progress>

        <p>
            <span class="js-count-value">{{ sentCount }}</span> / {{ secretSanta.associations|length }} messages sent so far.
            <br />
            <small>Note: the progress is refreshed every 5 seconds.</small>
        </p>
    </div>
{% endblock santa_content %}
{% block javascripts %}
    {{ importmap(['app', 'santa/send_messages'], {nonce: csp_nonce('script')}) }}
{% endblock %}
