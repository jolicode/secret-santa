{% extends 'santa/base.html.twig' %}

{% set currentStep = 5 %}

{% block santa_content %}
    <div class="content progress-page is-center">
        <span class="step-icon" aria-hidden="true"><i class="fas fa-spinner spin"></i></span>
        <h2 class="content-head is-center">Sending the private messages</h2>

        <div class="progress-box">
            <p>
                <strong>Keep this window open.</strong><br />
                You will be redirected automatically once every message has been sent.
            </p>

        {% set sentCount = secretSanta.associations|length - secretSanta.remainingAssociations|length %}
        <progress id="count-progress" value="{{ sentCount }}" max="{{ secretSanta.associations|length }}"
                  data-url="{{ url('send_messages', {hash: secretSanta.hash}) }}"
                  data-finish-url="{{ url('finish', {hash: secretSanta.hash}) }}">
            <span class="js-count-value">{{ sentCount }}</span> / {{ secretSanta.associations|length }} messages sent.
        </progress>

        <p class="progress-count">
            <strong class="js-count-value">{{ sentCount }}</strong> / {{ secretSanta.associations|length }} messages sent
        </p>
        </div>
    </div>
{% endblock santa_content %}
{% block javascripts %}
    {{ importmap(['app', 'santa/send_messages'], {nonce: csp_nonce('script')}) }}
{% endblock %}
