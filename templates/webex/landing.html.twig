{% extends 'base.html.twig' %}

{% block seo %}
    {{ include('_seo.html.twig', {
        title: 'Secret Santa for Webex Messaging',
        description: 'Organize a Secret Santa with your Webex Messaging team: free, no registration, each participant gets a private message with the name of the person to gift.',
    }) }}
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block banner %}
    <div class="jumbotron">
        <div class="snow foreground"></div>
        <div class="snow foreground layered"></div>
        <div class="snow middleground"></div>
        <div class="snow middleground layered"></div>

        <div class="jumbotron-inner hero">
            <div class="hero-text">
                <p class="hero-kicker">
                    <span>Free</span>
                    <span>Open-source</span>
                    <span>No registration</span>
                </p>

                <h1>Throw a Secret Santa with <mark>Webex Messaging</mark></h1>

                <p>
                    <strong>Randomly</strong> assign to each member of your <strong>Webex space</strong>
                    a person to whom they anonymously <strong>give a gift</strong>.
                    Compatible with Webex Free, no other account needed.
                </p>

                <div class="actions">
                    <a class="action hvr-buzz action-webex" href="{{ path('run', { application: 'webex' }) }}">
                        <i class="custom-fa-webex"></i> Run on Webex
                    </a>
                </div>
            </div>

            {# The private message each participant receives, as it shows in Webex #}
            <img class="hero-screenshot" src="{{ asset('images/webex/message.png') }}" alt="Sample private message received by a participant in Webex">
        </div>
    </div>
{% endblock banner %}

{% block content %}
    <div class="home">
        {{ include('content/_steps.html.twig', {application: 'webex'}) }}

        <p class="content is-center">
            Any question? Head over <a href="{{ path('faq') }}">our FAQ</a> to learn more about this integration.
        </p>
    </div>
{% endblock content %}
